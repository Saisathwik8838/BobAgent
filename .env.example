# ==========================================
# BobAgent Environment Configuration
# ==========================================

# Application
APP_NAME=BobAgent
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bobagent
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bobagent
# Sync DB URL for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bobagent

# Redis (Cache, Rate Limit, Task Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# LLM Providers & Models
# Options: mock, openai, ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o

# Ollama configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Anti-Hallucination & RAG Guardrails
MAX_AGENT_ITERATIONS=4
GROUNDEDNESS_THRESHOLD=0.75
ENABLE_LLM_JUDGE=true

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
